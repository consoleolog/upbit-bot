# 운영 DB
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# 테스트 DB (통합 테스트). 운영 DB와 다른 DB를 쓴다
TEST_DB_HOST=
TEST_DB_PORT=
TEST_DB_NAME=
TEST_DB_USER=
TEST_DB_PASSWORD=

# 업비트 API 키. 권한은 필요한 것만(지금은 자산조회), 허용 IP는 서버 IP로 지정한다
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 디스코드 웹훅 알림 (매매 중단·체결·시작 실패). 비워 두면 알림을 보내지 않는다
DISCORD_WEBHOOK_URL=

# 모의 실행 봇(paper-bot). paper로 두면 실거래 봇과 함께 뜬다. 비워 두면 모의 봇은 뜨지 않는다
# 모의 봇은 <DB_NAME>_paper DB를 쓴다 (처음 한 번 ./scripts/init_paper_db.sh)
COMPOSE_PROFILES=
# 모의 봇의 테스트 알림용 디스코드 웹훅 (실거래 알림과 다른 채널). 비워 두면 알림을 보내지 않는다
PAPER_DISCORD_WEBHOOK_URL=
